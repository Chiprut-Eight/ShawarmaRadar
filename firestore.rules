rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Temporary audit state sync document between owner's PC and mobile
    match /audit_state/current {
      allow read, write: if true;
    }
    // Anyone can read restaurant rankings and data
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
